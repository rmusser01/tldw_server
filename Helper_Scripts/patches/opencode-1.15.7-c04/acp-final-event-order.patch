diff --git a/packages/opencode/test/acp/event-subscription.test.ts b/packages/opencode/test/acp/event-subscription.test.ts
index a01680e..b201a8f 100644
--- a/packages/opencode/test/acp/event-subscription.test.ts
+++ b/packages/opencode/test/acp/event-subscription.test.ts
@@ -4,0 +5 @@ import type {
+  AssistantMessage,
@@ -977,0 +979,327 @@ describe("acp.agent event subscription", () => {
+
+function finalMessage(sessionID: string, id = "msg_final"): AssistantMessage {
+  return {
+    id,
+    sessionID,
+    role: "assistant",
+    time: { created: 1, completed: 2 },
+    parentID: "msg_user",
+    modelID: "big-pickle",
+    providerID: "opencode",
+    mode: "build",
+    agent: "build",
+    path: { cwd: "/tmp/opencode-acp-test", root: "/tmp/opencode-acp-test" },
+    cost: 0,
+    tokens: { input: 1, output: 2, reasoning: 0, cache: { read: 0, write: 0 } },
+  }
+}
+
+function completion(info: AssistantMessage): GlobalEventEnvelope {
+  return { payload: { id: `evt_${info.id}`, type: "message.updated", properties: { sessionID: info.sessionID, info } } }
+}
+
+function finalDelta(sessionID: string, text = "complete answer"): GlobalEventEnvelope {
+  return {
+    payload: {
+      id: "evt_delta",
+      type: "message.part.delta",
+      properties: {
+        sessionID,
+        messageID: "msg_final",
+        partID: "msg_final_part",
+        field: "text",
+        delta: text,
+      },
+    },
+  }
+}
+
+async function promptFixture(fn: (f: Awaited<ReturnType<typeof createPromptFixture>>) => Promise<void>) {
+  await using tmp = await tmpdir()
+  await provideTestInstance({
+    directory: tmp.path,
+    fn: async () => {
+      const f = await createPromptFixture()
+      try {
+        await fn(f)
+      } finally {
+        f.http.resolve({ data: { info: f.message } })
+        f.stop()
+        await Promise.allSettled(f.running)
+      }
+    },
+  })
+}
+
+async function createPromptFixture() {
+  const f = createFakeAgent()
+  const cwd = "/tmp/opencode-acp-test"
+  const sessionID = await f.agent.newSession({ cwd, mcpServers: [] }).then((x) => x.sessionId)
+  const message = finalMessage(sessionID)
+  const http = Promise.withResolvers<{ data: { info: AssistantMessage } }>()
+  const entered = Promise.withResolvers<void>()
+  const running: Array<ReturnType<typeof f.agent.prompt>> = []
+  const status = { settled: false }
+  f.sdk.session.prompt = () => {
+    entered.resolve()
+    return http.promise
+  }
+  f.sdk.session.command = f.sdk.session.prompt
+  f.sdk.session.abort = async () => ({ data: true })
+  f.sdk.session.messages = async () => ({ data: [{ info: message, parts: [] }] })
+  const providers = f.sdk.config.providers
+  f.sdk.config.providers = async () => {
+    const value = await providers()
+    value.data.providers[0].models["big-pickle"].limit = { context: 32000 }
+    return value
+  }
+  const start = (text = "summarize") => {
+    const result = f.agent.prompt({ sessionId: sessionID, prompt: [{ type: "text", text }] })
+    result.then(
+      () => {
+        status.settled = true
+      },
+      () => {
+        status.settled = true
+      },
+    )
+    running.push(result)
+    return result
+  }
+  return { ...f, sessionID, message, http, entered, running, status, start }
+}
+
+// A scheduler turn drains already-resolved SDK promises; it is not a streaming grace period.
+const nextTurn = () => new Promise<void>((resolve) => setImmediate(resolve))
+
+describe("acp.agent prompt forwarding", () => {
+  for (const command of [false, true]) {
+    test(`waits for final forwarding before usage and reply (${command ? "command" : "prompt"})`, async () => {
+      await promptFixture(async (f) => {
+        if (command) f.sdk.command.list = async () => ({ data: [{ name: "summarize" }] })
+        const blocked = Promise.withResolvers<void>()
+        const entered = Promise.withResolvers<void>()
+        const send = f.connection.sessionUpdate.bind(f.connection)
+        f.connection.sessionUpdate = async (params) => {
+          if (params.update.sessionUpdate === "agent_message_chunk") {
+            entered.resolve()
+            await blocked.promise
+          }
+          await send(params)
+        }
+        try {
+          const result = f.start(command ? "/summarize" : "summarize")
+          await f.entered.promise
+          f.controller.push(finalDelta(f.sessionID))
+          await entered.promise
+          f.http.resolve({ data: { info: f.message } })
+          f.controller.push(completion(f.message))
+          await nextTurn()
+          expect(f.status.settled).toBe(false)
+          expect(f.sessionUpdates.some((x) => x.update.sessionUpdate === "usage_update")).toBe(false)
+          blocked.resolve()
+          expect((await result).stopReason).toBe("end_turn")
+          expect(f.chunks.get(f.sessionID)).toBe("complete answer")
+          const kinds = f.sessionUpdates.map((x) => x.update.sessionUpdate)
+          expect(kinds.indexOf("agent_message_chunk")).toBeLessThan(kinds.indexOf("usage_update"))
+        } finally {
+          blocked.resolve()
+        }
+      })
+    })
+  }
+
+  test("retains completion observed before the SDK response without replaying text", async () => {
+    await promptFixture(async (f) => {
+      const result = f.start()
+      await f.entered.promise
+      f.controller.push(completion(f.message))
+      f.controller.push(finalDelta(f.sessionID))
+      await pollUntil(() => f.chunks.get(f.sessionID), "event-loop fence missing")
+      f.http.resolve({ data: { info: f.message } })
+      expect((await result).stopReason).toBe("end_turn")
+      expect(f.chunks.get(f.sessionID)).toBe("complete answer")
+    })
+  })
+
+  test("does not accept another session or another message as completion", async () => {
+    await promptFixture(async (f) => {
+      const result = f.start()
+      await f.entered.promise
+      f.controller.push(completion(finalMessage("ses_foreign")))
+      f.controller.push(completion(finalMessage(f.sessionID, "msg_foreign")))
+      f.controller.push(finalDelta(f.sessionID))
+      await pollUntil(() => f.chunks.get(f.sessionID), "event-loop fence missing")
+      f.http.resolve({ data: { info: f.message } })
+      await nextTurn()
+      expect(f.status.settled).toBe(false)
+      f.controller.push(completion(f.message))
+      expect((await result).stopReason).toBe("end_turn")
+    })
+  })
+
+  for (const action of ["cancel", "close", "eof"] as const) {
+    test(`fails a forwarding wait on ${action}`, async () => {
+      await promptFixture(async (f) => {
+        const result = f.start()
+        await f.entered.promise
+        f.http.resolve({ data: { info: f.message } })
+        await nextTurn()
+        if (action === "cancel") await f.agent.cancel({ sessionId: f.sessionID })
+        if (action === "close") await f.agent.closeSession({ sessionId: f.sessionID })
+        if (action === "eof") {
+          const reconnect = createEventStream()
+          f.sdk.global.event = async (opts: { signal: AbortSignal }) => ({ stream: reconnect.stream(opts.signal) })
+          f.controller.close()
+        }
+        expect(
+          await result.then(
+            () => null,
+            (error) => error,
+          ),
+        ).toBeInstanceOf(Error)
+      })
+    })
+  }
+
+  test("fails instead of completing after a native forwarding error", async () => {
+    await promptFixture(async (f) => {
+      const send = f.connection.sessionUpdate.bind(f.connection)
+      f.connection.sessionUpdate = async (params) => {
+        if (params.update.sessionUpdate === "agent_message_chunk") throw new Error("wire refused")
+        await send(params)
+      }
+      const result = f.start()
+      await f.entered.promise
+      f.controller.push(finalDelta(f.sessionID))
+      f.controller.push(completion(f.message))
+      f.http.resolve({ data: { info: f.message } })
+      expect(
+        await result.then(
+          () => null,
+          (error) => error,
+        ),
+      ).toMatchObject({ message: "wire refused" })
+    })
+  })
+
+  test("clears a failed prompt before a legitimate successor", async () => {
+    await promptFixture(async (f) => {
+      const first = f.start()
+      await f.entered.promise
+      f.http.reject(new Error("SDK failed"))
+      expect(
+        await first.then(
+          () => null,
+          (error) => error,
+        ),
+      ).toMatchObject({ message: "SDK failed" })
+      const message = finalMessage(f.sessionID, "msg_successor")
+      f.sdk.session.prompt = async () => {
+        f.controller.push(completion(message))
+        return { data: { info: message } }
+      }
+      expect((await f.start()).stopReason).toBe("end_turn")
+    })
+  })
+})
+
+describe("acp.agent stale forwarding ownership", () => {
+  for (const permission of [false, true]) {
+    test(`an old ${permission ? "permission" : "native send"} failure cannot reject a successor`, async () => {
+      await promptFixture(async (f) => {
+        const blocked = Promise.withResolvers<never>()
+        const admitted = Promise.withResolvers<void>()
+        const send = f.connection.sessionUpdate.bind(f.connection)
+        if (permission) {
+          f.sdk.permission.reply = async () => {
+            throw new Error("old permission reply failed")
+          }
+          f.connection.requestPermission = async () => {
+            admitted.resolve()
+            return blocked.promise
+          }
+        } else {
+          f.connection.sessionUpdate = async (params) => {
+            if (params.update.sessionUpdate === "agent_message_chunk") {
+              admitted.resolve()
+              await blocked.promise
+            }
+            await send(params)
+          }
+        }
+        const http = Promise.withResolvers<{ data: { info: AssistantMessage } }>()
+        const info = finalMessage(f.sessionID, "msg_successor")
+        try {
+          const first = f.start()
+          await f.entered.promise
+          f.controller.push(
+            permission
+              ? {
+                  payload: {
+                    id: "evt_old_permission",
+                    type: "permission.asked",
+                    properties: {
+                      id: "perm_old",
+                      sessionID: f.sessionID,
+                      permission: "read",
+                      patterns: ["README.md"],
+                      metadata: {},
+                      always: [],
+                    },
+                  },
+                }
+              : finalDelta(f.sessionID),
+          )
+          await admitted.promise
+          f.http.reject(new Error("SDK failed"))
+          expect(
+            await first.then(
+              () => null,
+              (error) => error,
+            ),
+          ).toMatchObject({ message: "SDK failed" })
+          const entered = Promise.withResolvers<void>()
+          f.sdk.session.prompt = () => {
+            entered.resolve()
+            return http.promise
+          }
+          const next = f.start()
+          await entered.promise
+          blocked.reject(new Error("old forwarding failed"))
+          await nextTurn()
+          f.controller.push(completion(info))
+          http.resolve({ data: { info } })
+          expect((await next).stopReason).toBe("end_turn")
+        } finally {
+          http.resolve({ data: { info } })
+          blocked.reject(new Error("cleanup"))
+        }
+      })
+    })
+  }
+
+  test("a falsy forwarding failure cannot become successful completion", async () => {
+    await promptFixture(async (f) => {
+      const foreign = await f.agent.newSession({ cwd: "/tmp/opencode-acp-test", mcpServers: [] })
+      const send = f.connection.sessionUpdate.bind(f.connection)
+      f.connection.sessionUpdate = async (params) => {
+        if (params.sessionId === f.sessionID && params.update.sessionUpdate === "agent_message_chunk") throw undefined
+        await send(params)
+      }
+      const result = f.start()
+      await f.entered.promise
+      f.controller.push(finalDelta(f.sessionID))
+      f.controller.push(completion(f.message))
+      f.controller.push(finalDelta(foreign.sessionId, "fence"))
+      await pollUntil(() => f.chunks.get(foreign.sessionId), "event-loop fence missing")
+      f.http.resolve({ data: { info: f.message } })
+      expect(
+        await result.then(
+          () => null,
+          (error) => error,
+        ),
+      ).toBeInstanceOf(Error)
+    })
+  })
+})
