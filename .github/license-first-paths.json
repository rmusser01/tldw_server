{
  "actionlint.yml": {
    "mode": "paths",
    "patterns": [
      ".github/actionlint.yaml",
      ".github/workflows/**",
      ".github/actions/**"
    ]
  },
  "frontend-e2e-tiers.yml": {
    "mode": "paths",
    "patterns": [
      "apps/packages/ui/src/**",
      "apps/tldw-frontend/**",
      "tldw_Server_API/**"
    ]
  },
  "jobs-suite.yml": {
    "mode": "paths",
    "patterns": [
      "tldw_Server_API/app/core/Jobs/**",
      "tldw_Server_API/app/api/v1/endpoints/jobs_admin.py",
      "tldw_Server_API/tests/Jobs/**",
      ".github/workflows/jobs-suite.yml"
    ]
  },
  "mcp-unified-rc.yml": {
