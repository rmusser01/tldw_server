{
  "response_base_dir": "../responses",
  "server": {
    "host": "127.0.0.1",
    "port": 0,
    "cors_origins": ["*"],
    "log_requests": true,
    "simulate_errors": false,
    "error_rate": 0,
    "require_auth": true
  },
  "streaming": {
    "enabled": true,
    "chunk_delay_ms": 5,
    "words_per_chunk": 6
  },
  "models": [
    { "id": "gpt-4.1-mini", "object": "model", "owned_by": "openai" },
    { "id": "text-embedding-3-small", "object": "model", "owned_by": "openai" }
  ],
  "responses": {
    "chat_completions": {
      "patterns": [
        {
          "match": { "system_prompt": "LIVE_TIER_ANALYSIS_ONE" },
          "response_file": "chat/analysis-one.json",
          "priority": 30
        },
        {
          "match": { "system_prompt": "LIVE_TIER_ANALYSIS_TWO" },
          "response_file": "chat/analysis-two.json",
          "priority": 30
        },
        {
          "match": { "content_regex": "(?i).*(summarize|source|research note).*" },
          "response_file": "chat/source-summary.json",
          "priority": 10
        }
      ],
      "default": "chat/default.json"
    },
    "embeddings": {
      "default": "embeddings/default.json"
    }
  }
}
