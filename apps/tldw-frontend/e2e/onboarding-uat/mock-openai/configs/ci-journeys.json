{
  "response_base_dir": "../responses",
  "server": {
    "host": "127.0.0.1",
    "port": 0,
    "cors_origins": [
      "*"
    ],
    "log_requests": true,
    "simulate_errors": false,
    "error_rate": 0,
    "require_auth": true
  },
  "streaming": {
    "enabled": true,
    "chunk_delay_ms": 5,
    "words_per_chunk": 6
  },
  "models": [
    {
      "id": "gpt-4.1-mini",
      "object": "model",
      "owned_by": "ci-controlled-downstream"
    }
  ],
  "responses": {
    "chat_completions": {
      "patterns": [
        {
          "match": {
            "system_prompt": "Generate 5 flashcards",
            "content_regex": "DNA stands for deoxyribonucleic acid"
          },
          "response_file": "chat/ci-biology-cards.json",
          "priority": 40
        },
        {
          "match": {
            "content_regex": "(?s)(?=.*Rowan Observatory)(?=.*What is the ticket price at Rowan Observatory)"
          },
          "response_file": "chat/ci-rowan-price.json",
          "priority": 30
        },
        {
          "match": {
            "content_regex": "(?s)(?=.*Rowan Observatory)(?=.*Mira Vale)(?=.*Cedar Ridge)(?=.*18:00)"
          },
          "response_file": "chat/ci-rowan-facts.json",
          "priority": 20
        }
      ],
      "default": "chat/default.json"
    },
    "embeddings": {
      "default": "embeddings/default.json"
    }
  }
}
