    "source": "\"\"\"Temporary guards and outcome receipt for the real PST tests.\"\"\"\nimport hashlib\nimport ipaddress\nimport json\nfrom pathlib import Path\nimport socket\n\nimport pytest\n\nattempts = {\"outbound\": 0, \"model\": 0}\noutcomes = []\noriginal_connect = socket.socket.connect\noriginal_connect_ex = socket.socket.connect_ex\noriginal_dns = socket.getaddrinfo\n\n\ndef local(host):\n    if host in (None, \"localhost\"):\n        return True\n    try:\n        return ipaddress.ip_address(str(host)).is_loopback\n    except ValueError:\n        return False\n\n\ndef guard_connection(original):\n    def connect(sock, address):\n        if sock.family != socket.AF_UNIX and not local(address[0]):\n            attempts[\"outbound\"] += 1\n            raise AssertionError(\"PST test blocked outbound connection\")\n        return original(sock, address)\n    return connect\n\n\ndef dns(host, *args, **kwargs):\n    if not local(host):\n        attempts[\"outbound\"] += 1\n        raise AssertionError(\"PST test blocked outbound DNS\")\n    return original_dns(host, *args, **kwargs)\n\n\nsocket.socket.connect = guard_connection(original_connect)\nsocket.socket.connect_ex = guard_connection(original_connect_ex)\nsocket.getaddrinfo = dns\n\n\n@pytest.fixture(scope=\"session\", autouse=True)\ndef prevent_models():\n    from tldw_Server_API.app.core.LLM_Calls import Summarization_General_Lib\n    patch = pytest.MonkeyPatch()\n    def forbidden(*args, **kwargs):\n        attempts[\"model\"] += 1\n        raise AssertionError(\"PST test blocked model analysis\")\n    patch.setattr(Summarization_General_Lib, \"analyze\", forbidden)\n    yield\n    patch.undo()\n    assert not any(attempts.values()), attempts\n\n\ndef pytest_runtest_logreport(report):\n    if report.when == \"call\" or report.failed or report.skipped:\n        outcomes.append({\"nodeid\": report.nodeid, \"phase\": report.when, \"outcome\": report.outcome})\n\n\ndef pytest_sessionfinish(session, exitstatus):\n    import pypff\n    path = Path(\"/tmp/tldw-real-pst-13377-synthetic.pst\")\n    receipt = {\"exitstatus\": int(exitstatus), \"attempts\": attempts,\n               \"libpff_version\": pypff.get_version(), \"fixture_size\": path.stat().st_size,\n               \"fixture_sha256\": hashlib.sha256(path.read_bytes()).hexdigest(), \"outcomes\": outcomes}\n    Path(\"/tmp/email_real_pst_guard_receipt_13377.json\").write_text(json.dumps(receipt, indent=2) + \"\\n\")\n",
