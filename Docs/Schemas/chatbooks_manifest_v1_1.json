{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tldw.ai/chatbooks/manifest/v1.1.json",
  "title": "Chatbooks manifest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "description",
    "author",
    "created_at",
    "updated_at",
    "export_id",
    "content_items",
    "relationships",
    "configuration",
    "statistics",
    "metadata",
    "user_info",
    "features_used",
    "file_inventory"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.1.0"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "export_id": {
      "type": ["string", "null"]
    },
    "content_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "description",
          "created_at",
          "updated_at",
          "tags",
          "metadata",
          "file_path",
          "checksum"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "conversation",
              "note",
              "character",
              "media",
              "embedding",
              "prompt",
              "evaluation",
              "world_book",
              "dictionary",
              "generated_document",
              "explainer_session"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "created_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "updated_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "file_path": {
            "type": ["string", "null"]
          },
          "checksum": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "target_id",
          "relationship_type",
          "metadata"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "relationship_type": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_media",
        "include_embeddings",
        "include_generated_content",
        "media_quality",
        "max_file_size_mb"
      ],
      "properties": {
        "include_media": {
          "type": "boolean"
        },
        "include_embeddings": {
          "type": "boolean"
        },
        "include_generated_content": {
          "type": "boolean"
        },
        "media_quality": {
          "type": "string",
          "enum": [
            "thumbnail",
            "compressed",
            "original"
          ]
        },
        "max_file_size_mb": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_conversations",
        "total_notes",
        "total_characters",
        "total_media_items",
        "total_prompts",
        "total_evaluations",
        "total_embeddings",
        "total_world_books",
        "total_dictionaries",
        "total_documents",
        "total_explainer_sessions",
        "total_size_bytes"
      ],
      "properties": {
        "total_conversations": {
          "type": "integer",
          "minimum": 0
        },
        "total_notes": {
          "type": "integer",
          "minimum": 0
        },
        "total_characters": {
          "type": "integer",
          "minimum": 0
        },
        "total_media_items": {
          "type": "integer",
          "minimum": 0
        },
        "total_prompts": {
          "type": "integer",
          "minimum": 0
        },
        "total_evaluations": {
          "type": "integer",
          "minimum": 0
        },
        "total_embeddings": {
          "type": "integer",
          "minimum": 0
        },
        "total_world_books": {
          "type": "integer",
          "minimum": 0
        },
        "total_dictionaries": {
          "type": "integer",
          "minimum": 0
        },
        "total_documents": {
          "type": "integer",
          "minimum": 0
        },
        "total_explainer_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "account_profiles": {
          "type": "integer",
          "minimum": 0
        },
        "account_settings": {
          "type": "integer",
          "minimum": 0
        },
        "conversations": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "integer",
          "minimum": 0
        },
        "characters": {
          "type": "integer",
          "minimum": 0
        },
        "media_records": {
          "type": "integer",
          "minimum": 0
        },
        "prompts": {
          "type": "integer",
          "minimum": 0
        },
        "evaluations": {
          "type": "integer",
          "minimum": 0
        },
        "embeddings": {
          "type": "integer",
          "minimum": 0
        },
        "world_books": {
          "type": "integer",
          "minimum": 0
        },
        "dictionaries": {
          "type": "integer",
          "minimum": 0
        },
        "generated_documents": {
          "type": "integer",
          "minimum": 0
        },
        "explainer_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "media_transcripts": {
          "type": "integer",
          "minimum": 0
        },
        "media_chunks": {
          "type": "integer",
          "minimum": 0
        },
        "media_stored_artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "media_pointers": {
          "type": "integer",
          "minimum": 0
        },
        "tags_categories_relationships": {
          "type": "integer",
          "minimum": 0
        },
        "sensitive_user_values": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "tags",
        "categories",
        "language",
        "license"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        },
        "license": {
          "type": ["string", "null"]
        },
        "binary_limits": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": true
    },
    "user_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id"
      ],
      "properties": {
        "user_id": {
          "type": ["string", "null"]
        }
      }
    },
    "features_used": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "content_envelopes",
          "file_inventory",
          "integrity_metadata",
          "typed_source_refs",
          "representations",
          "lossiness_metadata",
          "schema_refs",
          "redaction_profiles",
          "external_rehydration"
        ]
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": true
    },
    "source_instance": {
      "type": "object",
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_reader_version": {
          "type": "string"
        },
        "recommended_reader_version": {
          "type": "string"
        },
        "unsupported_feature_behavior": {
          "type": "string",
          "enum": [
            "warn_and_skip",
            "warn_lossy_import",
            "reject_import"
          ]
        },
        "v1_compatibility": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "file_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "media_type",
          "size_bytes",
          "integrity",
          "role"
        ],
        "additionalProperties": true,
        "properties": {
          "path": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "integrity": {
            "type": "object",
            "additionalProperties": true
          },
          "role": {
            "type": "string",
            "enum": [
              "payload",
              "rendered",
              "attachment",
              "schema",
              "readme",
              "other"
            ]
          },
          "content_item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "account_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "label",
          "source",
          "export_representation",
          "manifest_count_key",
          "import_handler_key",
          "dependencies",
          "sensitivity",
          "restore_status",
          "warning"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "export_representation": {
            "type": "string"
          },
          "manifest_count_key": {
            "type": "string"
          },
          "import_handler_key": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "public",
              "personal",
              "sensitive",
              "secret"
            ]
          },
          "restore_status": {
            "type": "string",
            "enum": [
              "restorable",
              "pointer_only",
              "non_restorable"
            ]
          },
          "warning": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "account_inventory_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "pointer_only_count",
        "sensitive_category_count",
        "warning_count",
        "warnings",
        "archive_size_bytes",
        "post_write_verification"
      ],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "account_profiles": {
              "type": "integer",
              "minimum": 0
            },
            "account_settings": {
              "type": "integer",
              "minimum": 0
            },
            "conversations": {
              "type": "integer",
              "minimum": 0
            },
            "notes": {
              "type": "integer",
              "minimum": 0
            },
            "characters": {
              "type": "integer",
              "minimum": 0
            },
            "world_books": {
              "type": "integer",
              "minimum": 0
            },
            "dictionaries": {
              "type": "integer",
              "minimum": 0
            },
            "prompts": {
              "type": "integer",
              "minimum": 0
            },
            "evaluations": {
              "type": "integer",
              "minimum": 0
            },
            "generated_documents": {
              "type": "integer",
              "minimum": 0
            },
            "explainer_sessions": {
              "type": "integer",
              "minimum": 0
            },
            "media_records": {
              "type": "integer",
              "minimum": 0
            },
            "media_transcripts": {
              "type": "integer",
              "minimum": 0
            },
            "media_chunks": {
              "type": "integer",
              "minimum": 0
            },
            "media_stored_artifacts": {
              "type": "integer",
              "minimum": 0
            },
            "media_pointers": {
              "type": "integer",
              "minimum": 0
            },
            "embeddings": {
              "type": "integer",
              "minimum": 0
            },
            "tags_categories_relationships": {
              "type": "integer",
              "minimum": 0
            },
            "sensitive_user_values": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "pointer_only_count": {
          "type": "integer",
          "minimum": 0
        },
        "sensitive_category_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "archive_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "post_write_verification": {
          "type": "boolean"
        }
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "evaluations": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "truncated": {
              "type": "boolean"
            },
            "max_rows": {
              "type": "integer",
              "minimum": 0
            },
            "continuations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}
