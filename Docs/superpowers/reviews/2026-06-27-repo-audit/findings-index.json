        "test_reproduced",
        "static_confirmed",
        "source_linked",
        "reasoned"
      ],
      "status": [
        "open",
        "in_review",
        "accepted",
        "deferred",
        "remediated",
        "false_positive"
      ],
      "validation_status": [
        "unvalidated",
