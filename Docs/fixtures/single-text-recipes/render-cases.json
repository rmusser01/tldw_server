      ],
      "blocks": [
        {
          "id": "a",
          "name": "a",
          "role": "system",
          "content": "{{x}} {x} $x <x> {{bad-name}} {{é}}",
          "order": 10,
          "is_template": true
        },
        {
          "id": "literal",
          "name": "literal",
          "role": "system",
          "content": "{{x}} {{unknown}}",
