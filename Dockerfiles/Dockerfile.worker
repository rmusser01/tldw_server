# Dockerfile.worker
# Docker image for embedding pipeline workers

FROM python:3.11-slim

# Install system dependencies (include audio build deps so PyAudio can compile)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    curl \
    git \
    ffmpeg \
    portaudio19-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy all local package inputs and the legal corpus required for installation.
COPY pyproject.toml README.md LICENSE /app/
COPY LICENSES /app/LICENSES
COPY tldw_Server_API /app/tldw_Server_API
COPY apps/mcp-unified/src /app/apps/mcp-unified/src
COPY packages/tldw_profile_core /app/packages/tldw_profile_core

# Install package with extras (multiplayer for PG support)
RUN pip install --no-cache-dir -e ".[multiplayer]"
RUN python -c "import mcp_unified; import tldw_profile_core"

# Copy application code
COPY tldw_Server_API/Config_Files /app/Config_Files

# Create necessary directories
RUN mkdir -p /app/Databases /app/Models /app/logs

# Set Python path
ENV PYTHONPATH=/app:$PYTHONPATH

# Default environment variables
ENV REDIS_URL=redis://localhost:6379
ENV EMBEDDINGS_REDIS_WORKERS_CHUNKING=1
ENV EMBEDDINGS_REDIS_WORKERS_EMBEDDING=1
ENV EMBEDDINGS_REDIS_WORKERS_STORAGE=1
ENV EMBEDDINGS_REDIS_WORKERS_CONTENT=1
ENV LOG_LEVEL=INFO

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

# Default command (will be overridden in docker-compose)
CMD ["python", "-m", "tldw_Server_API.app.core.Embeddings.services.redis_worker", "--stage", "all"]
