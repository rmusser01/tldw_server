# One-shot verifier. Build with --build-context trust=<public-key directory>.
# The trusted key set is part of this image's immutable digest, never a bundle mount.
FROM python:3.12-slim-bookworm AS runtime
ARG TLDW_SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.revision=${TLDW_SOURCE_COMMIT}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/tldw
RUN pip install --no-cache-dir --only-binary=:all: cryptography==45.0.6
WORKDIR /opt/tldw
COPY tldw_Server_API/scripts/app_bundle_control.py /opt/tldw/tldw_Server_API/scripts/app_bundle_control.py
COPY tldw_Server_API/app/core/Release /opt/tldw/tldw_Server_API/app/core/Release
COPY tldw_Server_API/app/core/AuthNZ/api_key_crypto.py /opt/tldw/tldw_Server_API/app/core/AuthNZ/api_key_crypto.py
RUN mkdir -m 0755 /opt/tldw/trusted-keys
COPY --from=trust --chmod=0444 /*.pub /opt/tldw/trusted-keys/
ENTRYPOINT ["python", "-m", "tldw_Server_API.scripts.app_bundle_control"]
