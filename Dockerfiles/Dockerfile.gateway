# Runtime gateway ships only its proxy dependency closure and source.
FROM oven/bun:1.3.2-debian AS gateway-dependencies
WORKDIR /gateway
COPY Dockerfiles/gateway/package.json Dockerfiles/gateway/bun.lock ./
RUN bun install --frozen-lockfile --production

FROM node:24-bookworm-slim AS runtime
ARG TLDW_SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.revision=${TLDW_SOURCE_COMMIT}
ENV NODE_ENV=production \
    TLDW_GATEWAY_LISTEN_HOST=0.0.0.0 \
    TLDW_GATEWAY_LISTEN_PORT=8080
WORKDIR /gateway
RUN useradd -m -u 10003 gateway
COPY --from=gateway-dependencies --chown=gateway:gateway /gateway/node_modules ./node_modules
COPY --chown=gateway:gateway Dockerfiles/gateway/package.json ./package.json
COPY --chown=gateway:gateway apps/tldw-frontend/gateway/server.mjs ./server.mjs
COPY --chown=gateway:gateway apps/tldw-frontend/gateway/routes.mjs ./routes.mjs
USER gateway
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD node -e "require('http').get({host:'127.0.0.1',port:8080,path:'/_tldw/status',headers:{Host:'127.0.0.1:'+process.env.TLDW_PUBLIC_PORT}},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "server.mjs"]
