# Production Dockerfile for tldw_server API
# - Multi-stage build keeps compiler/dev packages out of runtime image.
# - Runtime includes ffmpeg + libmagic + PortAudio runtime libs.

FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        python3-dev \
        portaudio19-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy packaging metadata, legal corpus, and source to build/install python deps.
COPY pyproject.toml README.md LICENSE /app/
COPY LICENSES /app/LICENSES
COPY tldw_Server_API /app/tldw_Server_API
COPY apps/mcp-unified/src /app/apps/mcp-unified/src

RUN pip install --upgrade pip && \
    pip install --prefix=/install .


FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libmagic1 \
        libportaudio2 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Bring in installed Python deps from the builder image.
COPY --from=builder /install /usr/local

# Create runtime user up front so content copies can avoid recursive chown.
RUN useradd -m -u 10001 appuser

# Runtime source/docs/scripts expected by server routes and helpers.
COPY --chown=appuser:appuser tldw_Server_API /app/tldw_Server_API
COPY --chown=appuser:appuser Docs /app/Docs
COPY --chown=appuser:appuser Helper_Scripts /app/Helper_Scripts
COPY --chown=appuser:appuser LICENSE /app/LICENSE
COPY --chown=appuser:appuser LICENSES /app/LICENSES
COPY --chown=appuser:appuser THIRD_PARTY_NOTICES.txt /app/THIRD_PARTY_NOTICES.txt
COPY Dockerfiles/entrypoints/tldw-app-first-run.sh /usr/local/bin/tldw-app-first-run

# Create writable runtime DB directory without copying host runtime data.
RUN mkdir -p /app/Databases && \
    chown appuser:appuser /app/Databases && \
    chmod +x /usr/local/bin/tldw-app-first-run
USER appuser

ARG HOST=0.0.0.0
ARG PORT=8000
ARG UVICORN_WORKERS=4
ARG LOG_LEVEL=info

ENV PYTHONPATH=/app/tldw_Server_API \
    HOST=${HOST} \
    PORT=${PORT} \
    UVICORN_WORKERS=${UVICORN_WORKERS} \
    LOG_LEVEL=${LOG_LEVEL}

EXPOSE 8000

# Basic healthcheck using the readiness probe (avoid extra curl dependency).
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD python -c "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/internal/ready', timeout=3).status == 200 else 1)"

ENTRYPOINT ["/usr/local/bin/tldw-app-first-run"]

# Start through the pinned receive-time MCP WebSocket guard.
CMD ["/bin/sh", "-c", "exec python -m tldw_Server_API.scripts.run_server_guarded_mcp --host \"$HOST\" --port \"$PORT\" --workers \"$UVICORN_WORKERS\" --log-level \"$LOG_LEVEL\" --proxy-headers"]
