+def test_reasserted_sequence_dependency_preserves_state_and_serializes_nextval(sequence_store):
+    """Characterize the supported sequence lock, including outer rollback release."""
+    store = sequence_store
+    started = threading.Event()
+    pid = []
+    future = None
+
+    def allocate():
+        with scoped_context(user_id=2), store.backend.transaction() as conn:
+            pid.append(conn.info.backend_pid)
+            started.set()
+            return _next(store, conn)
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        try:
+            with pytest.raises(RuntimeError, match="outer rollback"):
+                with scoped_context(user_id=1), store.backend.transaction() as conn:
+                    before = store.backend.execute(
+                        "SELECT * FROM pg_sequence WHERE seqrelid='media_id_seq'::regclass",
+                        connection=conn,
+                    ).rows
+                    state = store.backend.execute("SELECT * FROM media_id_seq", connection=conn).rows
+                    dependencies = store.backend.execute(
+                        "SELECT * FROM pg_depend WHERE objid='media_id_seq'::regclass",
+                        connection=conn,
+                    ).rows
+                    store.backend.execute(
+                        'ALTER SEQUENCE "public"."media_id_seq" OWNED BY "public"."media"."id"',
+                        connection=conn,
+                    )
+                    assert (
+                        store.backend.execute(
+                            "SELECT * FROM pg_sequence WHERE seqrelid='media_id_seq'::regclass",
+                            connection=conn,
+                        ).rows
+                        == before
+                    )
+                    assert store.backend.execute("SELECT * FROM media_id_seq", connection=conn).rows == state
+                    assert (
+                        store.backend.execute(
+                            "SELECT * FROM pg_depend WHERE objid='media_id_seq'::regclass",
+                            connection=conn,
+                        ).rows
+                        == dependencies
+                    )
+                    future = pool.submit(allocate)
+                    assert started.wait(5)
+                    deadline = time.monotonic() + 5
+                    blocked = False
+                    while time.monotonic() < deadline:
+                        with store.admin.transaction() as observer:
+                            blocked = store.admin.execute(
+                                "SELECT wait_event_type='Lock' FROM pg_stat_activity WHERE pid=%s",
+                                (pid[0],),
+                                connection=observer,
+                            ).scalar
+                        if blocked:
+                            break
+                        time.sleep(0.01)
+                    assert blocked and not future.done()
+                    raise RuntimeError("outer rollback")
+        finally:
+            if future is not None:
+                assert future.result(timeout=5) == 1
+
