+def test_sequence_savepoint_releases_lock_without_committing_caller_or_rewinding(sequence_store):
+    """Nontransactional setval survives rollback of only the temporary DDL lock."""
+    store = sequence_store
+
+    def allocate():
+        with scoped_context(user_id=2), store.backend.transaction() as other:
+            return _next(store, other)
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        with pytest.raises(RuntimeError, match="caller still owns rows"):
+            with scoped_context(user_id=1), store.backend.transaction() as conn:
+                store.backend.execute("INSERT INTO media VALUES (7, 1)", connection=conn)
+                with conn.transaction(force_rollback=True):
+                    store.backend.execute(
+                        'ALTER SEQUENCE "public"."media_id_seq" OWNED BY "public"."media"."id"',
+                        connection=conn,
+                    )
+                    store.backend.execute("SELECT setval('media_id_seq', 7)", connection=conn)
+                # Complete ordinary allocation while the outer caller stays open.
+                assert pool.submit(allocate).result(timeout=5) == 8
+                assert store.backend.execute("SELECT count(*) FROM media", connection=conn).scalar == 1
+                raise RuntimeError("caller still owns rows")
+    with scoped_context(user_id=1), store.backend.transaction() as conn:
+        assert store.backend.execute("SELECT count(*) FROM media", connection=conn).scalar == 0
+        assert _next(store, conn) == 9
+
