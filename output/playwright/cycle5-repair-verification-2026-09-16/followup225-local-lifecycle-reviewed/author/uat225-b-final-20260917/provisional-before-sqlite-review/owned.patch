+    assert run["dataset_id"] == f"legacy:{db.client_id}"
+    assert run["job_id"] == run_before["job_id"]
+    assert _rows(db, "note_graph_suggestions") == []
+    receipts = _rows(db, "note_graph_suggestion_operation_receipts")
