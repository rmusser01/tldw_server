+class BoundedOwnerLock:
+    """Keep real RLock semantics; bound an otherwise deadlocked test wait."""
+
+    def __init__(self):
+        self.lock = threading.RLock()
+
+    def __enter__(self):
+        if not self.lock.acquire(timeout=1):
+            raise RuntimeError("owner/state lock order deadlock")
+        return self
+
+    def __exit__(self, *_):
+        self.lock.release()
