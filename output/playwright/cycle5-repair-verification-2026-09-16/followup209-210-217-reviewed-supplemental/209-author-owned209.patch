+@pytest.mark.parametrize("operation", ["tag-edges", "sync-snapshot"])
+def test_graph_edge_and_sync_snapshot_reads_are_owner_scoped(note_owners, operation):
+    f = note_owners
+    f.alice.add_keyword("Snapshot spacer")
