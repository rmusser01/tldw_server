+         if (options?.clearAfterUse) {
+           void clearSetting(DISCUSS_MEDIA_PROMPT_SETTING);
+         }
+         return;
+       }
+       if (options?.clearAfterUse) {
+         void clearSetting(DISCUSS_MEDIA_PROMPT_SETTING);
+       }
+       const mode = getMediaChatHandoffMode(payload);
+       if (mode === "rag_media") {
