+
+const state = vi.hoisted(() => ({ review: vi.fn(), end: vi.fn(), previewAlwaysPresent: false }))
+vi.mock("@/services/background-proxy", () => ({ bgRequest: vi.fn(), bgUpload: vi.fn() }))
+vi.mock("@/services/service-prompts", async importOriginal => ({
