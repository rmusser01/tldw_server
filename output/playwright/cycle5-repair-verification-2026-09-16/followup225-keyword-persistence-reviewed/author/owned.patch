+        with db.transaction() as conn:
+            if invalid == "malformed":
+                conn.execute(f"UPDATE {table} SET merged_into_sync_id = ? WHERE id = ?", ("invalid", source["id"]))  # nosec B608
+            elif invalid == "cycle":
