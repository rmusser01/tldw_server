+"""Admin bootstrap proof uses a fake supported function, never an application DB."""
+
+import importlib
+import json
+import runpy
+from pathlib import Path
+from types import SimpleNamespace
+from uuid import uuid4
+
+import pytest
+
+
+@pytest.fixture
+def attempt(tmp_path, monkeypatch):
+    source = tmp_path / "frozen"
+    credentials = tmp_path / "credentials.private.json"
+    account = {"username": "synthetic_admin", "password": uuid4().hex, "email": "admin@example.invalid"}
+    credentials.write_text(json.dumps({"accountStatus": "planned-not-created", "accounts": {"admin": account}}))
+    credentials.chmod(0o600)
+    receipt = tmp_path / "attempt.completed.private.json"
+    request = {
+        "sourceRoot": str(source),
+        "credentialsPath": str(credentials),
+        "receiptPath": str(receipt),
+        "token": uuid4().hex,
+        "preparationHash": "this-preparation",
+    }
+    monkeypatch.setenv("AUTH_MODE", "multi_user")
+    monkeypatch.setenv("MATRIX_ADMIN_REQUEST", json.dumps(request))
+    calls = []
+    state = SimpleNamespace(result=True, error=None, origin=source / "create_admin.py")
+
+    async def create_admin_user_non_interactive(**kwargs):
+        calls.append(kwargs)
+        if state.error is not None:
+            raise state.error
+        return state.result
+
+    def fake_import(name):
+        assert name == "tldw_Server_API.app.core.AuthNZ.create_admin"
+        return SimpleNamespace(
+            __file__=str(state.origin), create_admin_user_non_interactive=create_admin_user_non_interactive
+        )
+
+    monkeypatch.setattr(importlib, "import_module", fake_import)
+    return SimpleNamespace(
+        source=source,
+        credentials=credentials,
+        account=account,
+        receipt=receipt,
+        request=request,
+        calls=calls,
+        state=state,
+    )
+
+
+def run_helper():
+    runpy.run_path(str(Path(__file__).with_name("bootstrap-admin-cell.py")), run_name="__main__")
+
+
+def test_only_normal_true_writes_private_identity_proof(attempt, capsys):
+    run_helper()
+    assert attempt.calls == [attempt.account]
+    assert json.loads(attempt.receipt.read_text()) == {
+        "status": "completed",
+        "action": "bootstrap-admin",
+        "token": attempt.request["token"],
+        "preparationHash": "this-preparation",
+    }
+    assert attempt.receipt.stat().st_mode & 0o777 == 0o600
+    captured = capsys.readouterr()
+    assert attempt.account["password"] not in captured.out + captured.err + attempt.receipt.read_text()
+    assert "accounts" not in attempt.receipt.read_text()
+
+
+@pytest.mark.parametrize("result", [False, None, 1, "true"])
+def test_false_or_merely_truthy_return_cannot_certify_bootstrap(attempt, result):
+    attempt.state.result = result
+    with pytest.raises(RuntimeError, match="complete"):
+        run_helper()
+    assert len(attempt.calls) == 1 and not attempt.receipt.exists()
+
+
+@pytest.mark.parametrize("failure", [SystemExit(0), KeyboardInterrupt(), RuntimeError("synthetic error")])
